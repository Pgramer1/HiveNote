# Neon DIRECT connection string (host without "-pooler"), same database as the Next.js app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-api-token"
# Must equal RAG_SERVICE_SECRET in the Next.js app.
RAG_SERVICE_SECRET="long-random-string"
# OCR for PDF pages without a text layer (scans, handwriting, picture-only slides): off | cloudflare | groq.
# Cloudflare's free plan shares 10,000 neurons/day with embeddings; one OCR page costs ~55-105 neurons.
OCR_PROVIDER="cloudflare"
OCR_DAILY_PAGE_BUDGET=60
OCR_MAX_PAGES_PER_DOCUMENT=40
# Only for OCR_PROVIDER=groq (Llama 4 Scout on Groq has its own per-model limits).
# GROQ_API_KEY="gsk_..."
